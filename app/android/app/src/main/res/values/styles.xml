<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the app starts; removed when Flutter draws its first frame.
         AppCompat parents are required by local_auth's fingerprint prompt. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter UI while it runs. -->
    <style name="NormalTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/slip_background</item>
    </style>
</resources>
